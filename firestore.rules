rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "YOUR_ADMIN_EMAIL";
    }

    function signedIn() {
      return request.auth != null;
    }

    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();

      match /likes/{visitorId} {
        allow read: if true;
        allow create: if signedIn()
          && request.auth.uid == visitorId
          && request.resource.data.keys().hasOnly(['visitorId','createdAt'])
          && request.resource.data.visitorId == request.auth.uid;
        allow delete: if signedIn()
          && resource.data.visitorId == request.auth.uid;
        allow update: if false;
      }

      match /shares/{shareId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['visitorId','createdAt'])
          && request.resource.data.visitorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if isAdmin() || resource.data.status == "approved";
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name','comment','status','visitorId','createdAt'])
          && request.resource.data.visitorId == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 60
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 3
          && request.resource.data.comment.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt','source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
      allow read, update, delete: if isAdmin();
    }
  }
}
